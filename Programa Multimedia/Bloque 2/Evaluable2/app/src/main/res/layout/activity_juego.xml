<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Gris_fondo"
    tools:context=".JuegoActivity">

    <TextView
        android:id="@+id/txtProgreso"
        android:layout_width="202dp"
        android:layout_height="64dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="95dp"
        android:gravity="center_vertical"
        android:textColor="@color/Blanco_letras"
        android:textSize="24sp"
        app:layout_constraintEnd_toStartOf="@+id/txtPuntos"
        app:layout_constraintHorizontal_bias="0.029"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="367dp"
        android:layout_height="25dp"
        android:layout_marginTop="32dp"
        android:backgroundTint="@color/Blanco_letras"
        android:progressTint="@color/Blanco_letras"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.454"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtProgreso" />

    <TextView
        android:id="@+id/txtPregunta"
        android:layout_width="317dp"
        android:layout_height="143dp"
        android:layout_marginTop="27dp"
        android:gravity="center_vertical"
        android:textColor="@color/Blanco_letras"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progressBar" />

    <TextView
        android:id="@+id/txtPuntos"
        android:layout_width="108dp"
        android:layout_height="20dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="20dp"
        android:textAlignment="viewEnd"
        android:textColor="@color/Blanco_letras"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnRespuesta1"
        android:layout_width="362dp"
        android:layout_height="66dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/Botones_naranja"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.489"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtPregunta" />

    <Button
        android:id="@+id/btnRespuesta2"
        android:layout_width="362dp"
        android:layout_height="66dp"
        android:layout_marginTop="29dp"
        android:backgroundTint="@color/Botones_naranja"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRespuesta1" />

    <Button
        android:id="@+id/btnRespuesta3"
        android:layout_width="362dp"
        android:layout_height="66dp"
        android:layout_marginTop="27dp"
        android:backgroundTint="@color/Botones_naranja"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRespuesta2" />

    <Button
        android:id="@+id/btnRespuesta4"
        android:layout_width="363dp"
        android:layout_height="66dp"
        android:layout_marginTop="27dp"
        android:backgroundTint="@color/Botones_naranja"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnRespuesta3" />

</androidx.constraintlayout.widget.ConstraintLayout>