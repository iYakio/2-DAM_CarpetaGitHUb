<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Gris_fondo"
    android:backgroundTint="@color/Gris_fondo"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView_Juego_Preguntas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:text="@string/Juego_de_preguntas"
        android:textColor="@color/Blanco_letras"
        android:textSize="34sp"
        tools:layout_editor_absoluteX="57dp"
        tools:layout_editor_absoluteY="343dp" />

    <EditText
        android:id="@+id/TextField_Tu_Nombre"
        android:layout_width="309dp"
        android:layout_height="44dp"
        android:ems="10"
        android:textColor="@color/Blanco_letras"
        android:textColorLink="@color/black"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="440dp" />

    <Button
        android:id="@+id/button_Jugar"
        android:layout_width="301dp"
        android:layout_height="51dp"
        android:backgroundTint="@color/Botones_naranja"
        android:text="@string/Jugar"
        android:textColorLink="@color/Botones_naranja"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="50dp"
        tools:layout_editor_absoluteY="508dp" />

    <Button
        android:id="@+id/button_Ver_ranking"
        android:layout_width="300dp"
        android:layout_height="51dp"
        android:backgroundTint="@color/Botones_naranja"
        android:text="@string/Ver_ranking"
        android:textSize="24sp"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="597dp" />

    <ImageView
        android:id="@+id/imageView_Mando_consola"
        android:layout_width="323dp"
        android:layout_height="264dp"
        app:srcCompat="@drawable/Trivial"
        tools:layout_editor_absoluteX="44dp"
        tools:layout_editor_absoluteY="68dp" />

    <TextView
        android:id="@+id/TextView_Tu_Nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Tu_nombre"
        android:textColor="@color/Blanco_letras"
        tools:layout_editor_absoluteX="51dp"
        tools:layout_editor_absoluteY="421dp" />

    <TextView
        android:id="@+id/textView_Titulo"
        android:layout_width="89dp"
        android:layout_height="39dp"
        android:text="TextView"
        android:textColor="@color/Blanco_letras"
        tools:layout_editor_absoluteX="16dp"
        tools:layout_editor_absoluteY="16dp" />
</androidx.constraintlayout.widget.ConstraintLayout>