<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/Gris_fondo"
    android:backgroundTint="@color/Gris_fondo"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView_Juego_Preguntas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:fontFamily="sans-serif"
        android:text="@string/Juego_de_preguntas"
        android:textColor="@color/Blanco_letras"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView_Mando" />

    <EditText
        android:id="@+id/textField_Tu_Nombre"
        android:layout_width="309dp"
        android:layout_height="44dp"
        android:ems="10"
        android:textColor="@color/Blanco_letras"
        android:textColorLink="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_Tu_Nombre" />

    <Button
        android:id="@+id/btnJugar"
        android:layout_width="301dp"
        android:layout_height="51dp"
        android:layout_marginTop="23dp"
        android:backgroundTint="@color/Botones_naranja"
        android:text="@string/Jugar"
        android:textColorLink="@color/Botones_naranja"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textField_Tu_Nombre" />

    <Button
        android:id="@+id/btnVerRanking"
        android:layout_width="301dp"
        android:layout_height="51dp"
        android:layout_marginTop="38dp"
        android:backgroundTint="@color/Botones_naranja"
        android:text="@string/Ver_ranking"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnJugar" />

    <TextView
        android:id="@+id/textView_Tu_Nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="51dp"
        android:layout_marginTop="24dp"
        android:text="@string/Tu_nombre"
        android:textColor="@color/Blanco_letras"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_Juego_Preguntas" />

    <TextView
        android:id="@+id/textView_Titulo"
        android:layout_width="162dp"
        android:layout_height="44dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="20dp"
        android:text="@string/GameIQ"
        android:textColor="@color/Blanco_letras"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/imageView_Mando"
        android:layout_width="301dp"
        android:layout_height="261dp"
        android:layout_marginTop="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_Titulo"
        app:srcCompat="@drawable/trivial" />
</androidx.constraintlayout.widget.ConstraintLayout>